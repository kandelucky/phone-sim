{
  "name": "Phone Sim",
  "short_name": "Phone Sim",
  "description": "A phone simulator for web apps and Capacitor apps.",
  "id": "./sim.html",
  "start_url": "./sim.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d232a",
  "theme_color": "#1d232a",
  "icons": [
    { "src": "icons/phone-sim-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/phone-sim-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/phone-sim-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/phone-sim.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "protocol_handlers": [
    { "protocol": "web+phonesim", "url": "./sim.html?app=%s" }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
